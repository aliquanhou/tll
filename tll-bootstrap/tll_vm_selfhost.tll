// TLL VM Self-Host Test: TLL VM executes compiler bytecode to compile itself
from "./lib/vm" import run
fn main() -> void {
    io.println("=== TLL VM Self-Host Test ===")
    io.println("Loading compiler bytecode...")
    let compilerBC = json.parse(fs.readFile("compiler_generated.tllbc"))
    io.println("Compiler loaded: " + convert.toString(arrays.length(compilerBC.functions)) + " functions")
    io.println("Running TLL VM to compile compiler.tll...")
    let startTime = convert.toFloat(convert.toString(math.floor(0))) // placeholder
    run(compilerBC)
    io.println("=== Self-Host Complete ===")
}
main()
