// Acceptance Test 1.3: Functions
fn add(a: int, b: int) -> int {
    return a + b
}

fn multiply(a: int, b: int) -> int {
    return a * b
}

fn main() -> void {
    io.println("3+4=" + convert.toString(add(3, 4)))
    io.println("5*6=" + convert.toString(multiply(5, 6)))
    io.println("add(10,20)+multiply(2,3)=" + convert.toString(add(10, 20) + multiply(2, 3)))
}
main()
