// Use TLL compiler to compile a simple program and save bytecode
from "./lib/linker" import linkAndCompile

io.println("=== TLL Compiler: Compile test_hello.tll ===")

let bytecode = linkAndCompile("test_hello.tll")

io.println("Compilation complete!")
io.println("Functions: " + convert.toString(arrays.length(bytecode.functions)))
io.println("Constants: " + convert.toString(arrays.length(bytecode.constants)))
io.println("mainFunctionIndex: " + convert.toString(bytecode.mainFunctionIndex))

// Save to JSON file
let jsonStr = json.stringify(bytecode)
fs.writeFile("hello_tll_compiled.tllbc", jsonStr)
io.println("Saved to hello_tll_compiled.tllbc")
io.println("File size: " + convert.toString(strings.length(jsonStr)) + " bytes")
io.println("")
io.println("=== Done ===")
