from "./lib/lexer" import tokenize
from "./lib/parser" import parse
from "./lib/codegen" import compile
from "./lib/vm" import run

io.println("=== Debug: add function bytecode ===")
let code = "fn add(a, b) { return a + b } let r = add(2, 3)"
io.println("Code: " + code)
let tokens = tokenize(code)
let ast = parse(tokens)
let program = compile(ast)
let funcs = program["functions"]
let fi = 0
while fi < arrays.length(funcs) {
    let f = arrays.get(funcs, fi)
    io.println("fn[" + convert.toString(fi) + "] " + f["name"] + " locals=" + convert.toString(f["localCount"]) + " instrs=" + convert.toString(arrays.length(f["instructions"])))
    let instrs = f["instructions"]
    let ii = 0
    while ii < arrays.length(instrs) {
        let inst = arrays.get(instrs, ii)
        io.println("  " + convert.toString(ii) + ": op=" + convert.toString(inst["op"]) + " operands=" + convert.toString(inst["operands"]))
        ii = ii + 1
    }
    fi = fi + 1
}
io.println("")
io.println("Constants:")
let consts = program["constants"]
let ci = 0
while ci < arrays.length(consts) {
    io.println("  [" + convert.toString(ci) + "] " + convert.toString(arrays.get(consts, ci)))
    ci = ci + 1
}
io.println("")
let result = run(program)
io.println("Result: " + convert.toString(result))
io.println("Expected: 5")
