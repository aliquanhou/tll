// TLL Module Linker
// Resolves imports, builds dependency graph, merges ASTs, and compiles

from "./lexer" import tokenize
from "./parser" import parse
from "./codegen" import compile

// ============ Path Resolution ============

// Get directory from a file path
fn getDir(filePath: string) -> string {
    let lastSlash = strings.lastIndexOf(filePath, "/")
    if lastSlash < 0 {
        return "."
    }
    return strings.substring(filePath, 0, lastSlash)
}

// Resolve a module path relative to current file
fn resolveModulePath(currentFile: string, importPath: string) -> string {
    let dir = getDir(currentFile)
    let cleanPath = importPath
    // Handle ./ prefix
    if strings.length(cleanPath) >= 2 && strings.substring(cleanPath, 0, 2) == "./" {
        cleanPath = strings.substring(cleanPath, 2, strings.length(cleanPath))
    }
    // Handle ../ prefix (go up one directory)
    if strings.length(cleanPath) >= 3 && strings.substring(cleanPath, 0, 3) == "../" {
        cleanPath = strings.substring(cleanPath, 3, strings.length(cleanPath))
        let lastSlash = strings.lastIndexOf(dir, "/")
        if lastSlash >= 0 {
            dir = strings.substring(dir, 0, lastSlash)
        }
    }
    let fullPath = dir + "/" + cleanPath
    // Add .tll extension if not present
    if !strings.endsWith(fullPath, ".tll") {
        fullPath = fullPath + ".tll"
    }
    return fullPath
}

// Check if a module path is relative (starts with ./ or ../)
fn isRelativeModule(modPath: string) -> bool {
    if strings.length(modPath) >= 2 {
        let first = strings.substring(modPath, 0, 1)
        let second = strings.substring(modPath, 1, 2)
        if first == "." && second == "/" {
            return true
        }
        if first == "." && second == "." {
            return true
        }
    }
    return false
}

// ============ Import Extraction ============

// Extract import module paths from AST
fn extractImports(ast: map) -> list {
    let imports: list = []
    let stmts = ast.statements
    let i = 0
    while i < arrays.length(stmts) {
        let stmt = arrays.get(stmts, i)
        if stmt.kind == "Import" {
            arrays.push(imports, stmt.modulePath)
        }
        i = i + 1
    }
    return imports
}

// ============ Dependency Resolution ============

// Global state for dependency resolution
let resolvedFiles: list = []
let visitedFiles: list = []
let circularDependencyError: string = ""

// Check if a file is already in the resolved list
fn isResolved(filePath: string) -> bool {
    let i = 0
    while i < arrays.length(resolvedFiles) {
        if arrays.get(resolvedFiles, i) == filePath {
            return true
        }
        i = i + 1
    }
    return false
}

// Check if a file is currently being visited (for circular dependency detection)
fn isVisited(filePath: string) -> bool {
    let i = 0
    while i < arrays.length(visitedFiles) {
        if arrays.get(visitedFiles, i) == filePath {
            return true
        }
        i = i + 1
    }
    return false
}

// Extract import paths from source code using string matching
fn extractImportsFromSource(source: string) -> list {
    let imports: list = []
    let lines = strings.split(source, "\n")
    let i = 0
    while i < arrays.length(lines) {
        let line = arrays.get(lines, i)
        // Check for "from ... import" pattern
        if strings.startsWith(line, "from ") {
            let firstQuote = strings.indexOf(line, "\"")
            if firstQuote >= 0 {
                let rest = strings.substring(line, firstQuote + 1, strings.length(line))
                let secondQuote = strings.indexOf(rest, "\"")
                if secondQuote >= 0 {
                    let modPath = strings.substring(rest, 0, secondQuote)
                    arrays.push(imports, modPath)
                }
            }
        }
        i = i + 1
    }
    return imports
}

// Recursively resolve dependencies
fn load(filePath: string) -> void {
    if isResolved(filePath) {
        return
    }
    if isVisited(filePath) {
        circularDependencyError = "Circular dependency detected: " + filePath
        io.println("Error: " + circularDependencyError)
        return
    }
    arrays.push(visitedFiles, filePath)

    let source = fs.readFile(filePath)
    let imports = extractImportsFromSource(source)

    // Load dependencies first
    let i = 0
    while i < arrays.length(imports) {
        let modPath = arrays.get(imports, i)
        if isRelativeModule(modPath) {
            let depPath = resolveModulePath(filePath, modPath)
            load(depPath)
        }
        // Stdlib modules (io, math, etc.) are built-in, skip
        i = i + 1
    }

    // Add current file after dependencies
    arrays.push(resolvedFiles, filePath)
}

// Resolve all dependencies for an entry file
export fn resolveDependencies(entryFile: string) -> list {
    resolvedFiles = []
    visitedFiles = []
    circularDependencyError = ""
    load(entryFile)
    return resolvedFiles
}


// Extract import aliases from source: returns two parallel lists (aliasNames, originalNames)
fn extractImportAliases(source: string) -> list {
    let aliasNames: list = []
    let originalNames: list = []
    let lines = strings.split(source, "\n")
    let i = 0
    while i < arrays.length(lines) {
        let line = arrays.get(lines, i)
        if strings.startsWith(line, "from ") || strings.startsWith(line, "import ") {
            // Find the import list after 'import'
            let importIdx = strings.indexOf(line, "import ")
            if importIdx >= 0 {
                let rest = strings.substring(line, importIdx + 7, strings.length(line))
                // Split by comma
                let parts = strings.split(rest, ",")
                let p = 0
                while p < arrays.length(parts) {
                    let part = arrays.get(parts, p)
                    part = strings.trim(part)
                    if strings.length(part) > 0 {
                        let asIdx = strings.indexOf(part, " as ")
                        if asIdx >= 0 {
                            let orig = strings.trim(strings.substring(part, 0, asIdx))
                            let alias = strings.trim(strings.substring(part, asIdx + 4, strings.length(part)))
                            arrays.push(aliasNames, alias)
                            arrays.push(originalNames, orig)
                        }
                    }
                    p = p + 1
                }
            }
        }
        i = i + 1
    }
    // Return as a 2-element list [aliasNames, originalNames]
    let result: list = []
    arrays.push(result, aliasNames)
    arrays.push(result, originalNames)
    return result
}

// Replace alias identifiers in a line with original names (lexical replacement, skips strings)
fn replaceAliasesInLine(line: string, aliasNames: list, originalNames: list) -> string {
    if arrays.length(aliasNames) == 0 {
        return line
    }
    let result = ""
    let pos = 0
    let lineLen = strings.length(line)
    while pos < lineLen {
        let ch = strings.charAt(line, pos)
        // Skip string literals
        if ch == "\"" {
            result = result + ch
            pos = pos + 1
            while pos < lineLen {
                let c2 = strings.charAt(line, pos)
                result = result + c2
                pos = pos + 1
                if c2 == "\"" {
                    break
                }
            }
            continue
        }
        // Skip line comments
        if ch == "/" && pos + 1 < lineLen && strings.charAt(line, pos + 1) == "/" {
            result = result + strings.substring(line, pos, lineLen)
            pos = lineLen
            continue
        }
        // Read identifier
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_" {
            let start = pos
            pos = pos + 1
            while pos < lineLen {
                let c3 = strings.charAt(line, pos)
                if (c3 >= "a" && c3 <= "z") || (c3 >= "A" && c3 <= "Z") || (c3 >= "0" && c3 <= "9") || c3 == "_" {
                    pos = pos + 1
                } else {
                    break
                }
            }
            let ident = strings.substring(line, start, pos)
            // Check if it's an alias
            let found = false
            let a = 0
            while a < arrays.length(aliasNames) {
                if arrays.get(aliasNames, a) == ident {
                    result = result + arrays.get(originalNames, a)
                    found = true
                    break
                }
                a = a + 1
            }
            if !found {
                result = result + ident
            }
        } else {
            result = result + ch
            pos = pos + 1
        }
    }
    return result
}


// ============ AST-level Import Alias Resolution ============

// Find alias index in parallel list, return -1 if not found
fn findAliasIndex(name: string, aliasNames: list) -> int {
    let i = 0
    while i < arrays.length(aliasNames) {
        if arrays.get(aliasNames, i) == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// Rename identifiers in an expression (AST-level, does not touch Member.property)
fn renameInExpr(expr: map, aliasNames: list, originalNames: list) -> void {
    if expr == null { return }
    let kind = expr.kind
    if kind == "Ident" {
        let idx = findAliasIndex(expr.name, aliasNames)
        if idx >= 0 {
            expr.name = arrays.get(originalNames, idx)
        }
        return
    }
    if kind == "Member" {
        renameInExpr(expr.object, aliasNames, originalNames)
        return
    }
    if kind == "Call" {
        renameInExpr(expr.callee, aliasNames, originalNames)
        let i = 0
        while i < arrays.length(expr.args) {
            renameInExpr(arrays.get(expr.args, i), aliasNames, originalNames)
            i = i + 1
        }
        return
    }
    if kind == "Index" {
        renameInExpr(expr.object, aliasNames, originalNames)
        renameInExpr(expr.index, aliasNames, originalNames)
        return
    }
    if kind == "Binary" {
        renameInExpr(expr.left, aliasNames, originalNames)
        renameInExpr(expr.right, aliasNames, originalNames)
        return
    }
    if kind == "Unary" {
        renameInExpr(expr.argument, aliasNames, originalNames)
        return
    }
    if kind == "Array" {
        let i = 0
        while i < arrays.length(expr.elements) {
            renameInExpr(arrays.get(expr.elements, i), aliasNames, originalNames)
            i = i + 1
        }
        return
    }
    if kind == "Map" {
        let i = 0
        while i < arrays.length(expr.entries) {
            let entry = arrays.get(expr.entries, i)
            renameInExpr(entry.value, aliasNames, originalNames)
            i = i + 1
        }
        return
    }
    if kind == "Pipe" {
        renameInExpr(expr.left, aliasNames, originalNames)
        renameInExpr(expr.right, aliasNames, originalNames)
        return
    }
    if kind == "Assignment" {
        renameInExpr(expr.value, aliasNames, originalNames)
        return
    }
    if kind == "Ternary" {
        renameInExpr(expr.condition, aliasNames, originalNames)
        renameInExpr(expr.consequent, aliasNames, originalNames)
        renameInExpr(expr.alternate, aliasNames, originalNames)
        return
    }
    // Int, Float, String, Bool, Null - no action
}

// Rename identifiers in top-level statements (does NOT enter function bodies)
fn renameTopLevelStmts(stmts: list, aliasNames: list, originalNames: list) -> void {
    let i = 0
    while i < arrays.length(stmts) {
        let stmt = arrays.get(stmts, i)
        if stmt == null { i = i + 1; continue }
        let kind = stmt.kind
        if kind == "Let" || kind == "Const" {
            renameInExpr(stmt.value, aliasNames, originalNames)
        } else if kind == "Expression" || kind == "ExpressionStatement" {
            renameInExpr(stmt.expression, aliasNames, originalNames)
        } else if kind == "If" {
            renameInExpr(stmt.condition, aliasNames, originalNames)
            if stmt.consequent != null && stmt.consequent.statements != null {
                renameTopLevelStmts(stmt.consequent.statements, aliasNames, originalNames)
            }
            if stmt.alternate != null {
                if stmt.alternate.statements != null {
                    renameTopLevelStmts(stmt.alternate.statements, aliasNames, originalNames)
                } else {
                    let altList: list = []
                    arrays.push(altList, stmt.alternate)
                    renameTopLevelStmts(altList, aliasNames, originalNames)
                }
            }
        } else if kind == "While" {
            renameInExpr(stmt.condition, aliasNames, originalNames)
            if stmt.body != null && stmt.body.statements != null {
                renameTopLevelStmts(stmt.body.statements, aliasNames, originalNames)
            }
        } else if kind == "For" {
            renameInExpr(stmt.init, aliasNames, originalNames)
            renameInExpr(stmt.condition, aliasNames, originalNames)
            renameInExpr(stmt.update, aliasNames, originalNames)
            if stmt.body != null && stmt.body.statements != null {
                renameTopLevelStmts(stmt.body.statements, aliasNames, originalNames)
            }
        } else if kind == "Block" {
            if stmt.statements != null {
                renameTopLevelStmts(stmt.statements, aliasNames, originalNames)
            }
        } else if kind == "Return" {
            renameInExpr(stmt.argument, aliasNames, originalNames)
        } else if kind == "Throw" {
            renameInExpr(stmt.argument, aliasNames, originalNames)
        } else if kind == "Try" {
            if stmt.block != null && stmt.block.statements != null {
                renameTopLevelStmts(stmt.block.statements, aliasNames, originalNames)
            }
            if stmt.handler != null && stmt.handler.body != null && stmt.handler.body.statements != null {
                renameTopLevelStmts(stmt.handler.body.statements, aliasNames, originalNames)
            }
            if stmt.finalizer != null && stmt.finalizer.statements != null {
                renameTopLevelStmts(stmt.finalizer.statements, aliasNames, originalNames)
            }
        }
        // Fn, Import, Export, Tool - no action
        // Fn body is local scope, Import/Export are removed later
        i = i + 1
    }
}

// Extract import aliases from AST (returns [aliasNames, originalNames])
fn extractAliasesFromAST(ast: map) -> list {
    let aliasNames: list = []
    let originalNames: list = []
    let i = 0
    while i < arrays.length(ast.statements) {
        let stmt = arrays.get(ast.statements, i)
        if stmt != null && stmt.kind == "Import" {
            let j = 0
            while j < arrays.length(stmt.names) {
                let binding = arrays.get(stmt.names, j)
                // Parser stores {name, alias} map objects
                let origName = binding.name
                let aliasName = binding.alias
                if aliasName == null { aliasName = origName }
                arrays.push(aliasNames, aliasName)
                arrays.push(originalNames, origName)
                j = j + 1
            }
        }
        i = i + 1
    }
    let result: list = []
    arrays.push(result, aliasNames)
    arrays.push(result, originalNames)
    return result
}

// ============ Full Link and Compile ============

// Link all modules and compile to bytecode
export fn linkAndCompile(entryFile: string) -> map {
    let files = resolveDependencies(entryFile)
    if circularDependencyError != "" {
        io.println("Compilation aborted due to circular dependency.")
        let errorResult: map = {}
        errorResult.error = circularDependencyError
        errorResult.functions = []
        errorResult.constants = []
        errorResult.mainFunctionIndex = 0
        return errorResult
    }
    io.println("Resolved " + convert.toString(arrays.length(files)) + " module(s):")
    let i = 0
    while i < arrays.length(files) {
        io.println("  " + arrays.get(files, i))
        i = i + 1
    }

    // Parse each module to AST, rename top-level import aliases, merge statements
    let allStatements: list = []
    let j = 0
    while j < arrays.length(files) {
        let filePath = arrays.get(files, j)
        let source = fs.readFile(filePath)
        // Remove export keyword (functions are now in the same combined program)
        source = strings.replaceAll(source, "export fn ", "fn ")
        source = strings.replaceAll(source, "export const ", "const ")
        source = strings.replaceAll(source, "export let ", "let ")
        // Parse to AST
        let tokens = tokenize(source)
        let ast = parse(tokens)
        // Extract import aliases from AST
        let aliasData = extractAliasesFromAST(ast)
        let fileAliasNames = arrays.get(aliasData, 0)
        let fileOriginalNames = arrays.get(aliasData, 1)
        // Rename top-level identifiers (AST-level, does not touch local vars or member props)
        renameTopLevelStmts(ast.statements, fileAliasNames, fileOriginalNames)
        // Collect non-import statements
        let i = 0
        while i < arrays.length(ast.statements) {
            let stmt = arrays.get(ast.statements, i)
            if stmt != null && stmt.kind != "Import" {
                arrays.push(allStatements, stmt)
            }
            i = i + 1
        }
        j = j + 1
    }

    // Build combined program AST and compile
    let program = { statements: allStatements }
    let bytecode = compile(program)

    return bytecode
}
