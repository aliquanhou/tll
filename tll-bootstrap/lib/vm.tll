// TLL VM - Self-hosting Bootstrap (v1.0 Phase 5)
// Bytecode virtual machine, rewritten from TypeScript
// Uses vm_setReg/vm_setLocal/vm_setGlobal helpers (TLL list index assignment is unreliable)

// ============ OpCode constants ============
let OP_LOAD_CONST = 0
let OP_LOAD_VAR = 1
let OP_STORE_VAR = 2
let OP_ADD = 3
let OP_SUB = 4
let OP_MUL = 5
let OP_DIV = 6
let OP_MOD = 7
let OP_POW = 8
let OP_EQ = 9
let OP_NEQ = 10
let OP_LT = 11
let OP_GT = 12
let OP_LE = 13
let OP_GE = 14
let OP_AND = 15
let OP_OR = 16
let OP_NOT = 17
let OP_NEG = 18
let OP_JMP = 19
let OP_JMP_IF_FALSE = 20
let OP_CALL = 21
let OP_RET = 22
let OP_PRINT = 23
let OP_PRINTLN = 24
let OP_MAKE_ARRAY = 25
let OP_MAKE_MAP = 26
let OP_INDEX_GET = 28
let OP_INDEX_SET = 29
let OP_MEMBER_GET = 30
let OP_MEMBER_SET = 31
let OP_HALT = 32
let OP_NOP = 33
let OP_PUSH = 34
let OP_CONCAT = 35
let OP_LOAD_BUILTIN = 36
let OP_THROW = 37
let OP_TRY_START = 38
let OP_TRY_END = 39
let OP_LOAD_GLOBAL = 40
let OP_STORE_GLOBAL = 41

// ============ VM state ============
let vm_constants: auto = []
let vm_functions: auto = []
let vm_globals: auto = []
let vm_callStack: auto = []
let vm_result: auto = null
let vm_halted = false
let vm_lastResultReg = 0  // track last expression result register for HALT

// Current frame state (global vars)
let vm_pc = 0
let vm_registers: auto = []
let vm_locals: auto = []
let vm_argStack: auto = []
let vm_returnReg = 0
let vm_fnIdx = 0

// ============ Helper: init registers ============
fn vm_initRegisters() -> list {
    let regs: auto = []
    let i = 0
    while i < 256 {
        arrays.push(regs, null)
        i = i + 1
    }
    return regs
}

// ============ Set register (works around TLL list index assignment) ============
fn vm_setReg(idx: int, value: auto) -> void {
    let newRegs: auto = []
    let i = 0
    while i < arrays.length(vm_registers) {
        if i == idx {
            arrays.push(newRegs, value)
        } else {
            arrays.push(newRegs, arrays.get(vm_registers, i))
        }
        i = i + 1
    }
    vm_registers = newRegs
    vm_lastResultReg = idx
}

fn vm_getReg(idx: int) -> any {
    return arrays.get(vm_registers, idx)
}

// ============ Set local ============
fn vm_setLocal(idx: int, value: auto) -> void {
    let newLocals: auto = []
    let i = 0
    while i < arrays.length(vm_locals) {
        if i == idx {
            arrays.push(newLocals, value)
        } else {
            arrays.push(newLocals, arrays.get(vm_locals, i))
        }
        i = i + 1
    }
    vm_locals = newLocals
}

// ============ Set global ============
fn vm_setGlobal(idx: int, value: auto) -> void {
    let newGlobals: auto = []
    let i = 0
    while i < arrays.length(vm_globals) {
        if i == idx {
            arrays.push(newGlobals, value)
        } else {
            arrays.push(newGlobals, arrays.get(vm_globals, i))
        }
        i = i + 1
    }
    vm_globals = newGlobals
}

// ============ Save/restore frame ============
fn vm_saveFrame() -> void {
    let frame = {
        pc: vm_pc,
        registers: vm_registers,
        locals: vm_locals,
        argStack: vm_argStack,
        returnReg: vm_returnReg,
        fnIdx: vm_fnIdx
    }
    arrays.push(vm_callStack, frame)
}

fn vm_restoreFrame() -> bool {
    if arrays.length(vm_callStack) == 0 {
        return false
    }
    let frame = arrays.get(vm_callStack, arrays.length(vm_callStack) - 1)
    arrays.pop(vm_callStack)
    vm_pc = frame["pc"]
    vm_registers = frame["registers"]
    vm_locals = frame["locals"]
    vm_argStack = frame["argStack"]
    vm_returnReg = frame["returnReg"]
    vm_fnIdx = frame["fnIdx"]
    return true
}

// ============ Main entry ============
export fn run(program: map) -> any {
    vm_constants = program["constants"]
    vm_functions = program["functions"]
    vm_globals = []
    vm_callStack = []
    vm_result = null
    vm_halted = false
    vm_lastResultReg = 0

    let globalCount = program["globalCount"]
    if globalCount == null { globalCount = 0 }
    let gi = 0
    while gi < globalCount {
        arrays.push(vm_globals, null)
        gi = gi + 1
    }

    let mainIdx = program["mainFunctionIndex"]
    if mainIdx == null { mainIdx = arrays.length(vm_functions) - 1 }
    vm_fnIdx = mainIdx
    vm_pc = 0
    vm_registers = vm_initRegisters()
    let mainFn = arrays.get(vm_functions, mainIdx)
    let localCount = mainFn["localCount"]
    if localCount == null { localCount = 0 }
    vm_locals = []
    let li = 0
    while li < localCount {
        arrays.push(vm_locals, null)
        li = li + 1
    }
    vm_argStack = []
    vm_returnReg = -1

    vm_runLoop()
    return vm_result
}

// ============ Instruction loop ============
fn vm_runLoop() -> void {
    while !vm_halted {
        let func = arrays.get(vm_functions, vm_fnIdx)
        let instructions = func["instructions"]
        if vm_pc >= arrays.length(instructions) {
            if arrays.length(vm_callStack) == 0 {
                vm_halted = true
                vm_result = vm_getReg(vm_lastResultReg)
                break
            }
            let returnValue = null
            let retReg = vm_returnReg
            vm_restoreFrame()
            if retReg >= 0 {
                vm_setReg(retReg, returnValue)
            }
            continue
        }
        let inst = arrays.get(instructions, vm_pc)
        vm_pc = vm_pc + 1
        vm_executeInstruction(inst)
    }
}

// ============ Execute instruction ============
fn vm_executeInstruction(inst: map) -> void {
    let op = inst["op"]
    let operands = inst["operands"]
    let a = 0
    let b = 0
    let c = 0
    if arrays.length(operands) > 0 { a = arrays.get(operands, 0) }
    if arrays.length(operands) > 1 { b = arrays.get(operands, 1) }
    if arrays.length(operands) > 2 { c = arrays.get(operands, 2) }

    if op == OP_LOAD_CONST { vm_setReg(a, arrays.get(vm_constants, b)); return }
    if op == OP_LOAD_VAR { vm_setReg(a, arrays.get(vm_locals, b)); return }
    if op == OP_STORE_VAR { vm_setLocal(a, vm_getReg(b)); vm_lastResultReg = b; return }
    if op == OP_LOAD_GLOBAL { vm_setReg(a, arrays.get(vm_globals, b)); return }
    if op == OP_STORE_GLOBAL { vm_setGlobal(a, vm_getReg(b)); vm_lastResultReg = b; return }
    if op == OP_ADD {
        let rv = vm_getReg(b)
        let lv = vm_getReg(c)
        if convert.typeOf(rv) == "string" || convert.typeOf(lv) == "string" {
            vm_setReg(a, convert.toString(rv) + convert.toString(lv))
        } else {
            vm_setReg(a, rv + lv)
        }
        return
    }
    if op == OP_SUB { vm_setReg(a, vm_getReg(b) - vm_getReg(c)); return }
    if op == OP_MUL { vm_setReg(a, vm_getReg(b) * vm_getReg(c)); return }
    if op == OP_DIV { vm_setReg(a, vm_getReg(b) / vm_getReg(c)); return }
    if op == OP_MOD { vm_setReg(a, vm_getReg(b) % vm_getReg(c)); return }
    if op == OP_POW { vm_setReg(a, math.pow(vm_getReg(b), vm_getReg(c))); return }
    if op == OP_EQ { vm_setReg(a, vm_getReg(b) == vm_getReg(c)); return }
    if op == OP_NEQ { vm_setReg(a, vm_getReg(b) != vm_getReg(c)); return }
    if op == OP_LT { vm_setReg(a, vm_getReg(b) < vm_getReg(c)); return }
    if op == OP_GT { vm_setReg(a, vm_getReg(b) > vm_getReg(c)); return }
    if op == OP_LE { vm_setReg(a, vm_getReg(b) <= vm_getReg(c)); return }
    if op == OP_GE { vm_setReg(a, vm_getReg(b) >= vm_getReg(c)); return }
    if op == OP_AND { vm_setReg(a, vm_getReg(b) && vm_getReg(c)); return }
    if op == OP_OR { vm_setReg(a, vm_getReg(b) || vm_getReg(c)); return }
    if op == OP_NOT { vm_setReg(a, !vm_getReg(b)); return }
    if op == OP_NEG { vm_setReg(a, -vm_getReg(b)); return }
    if op == OP_JMP { vm_pc = a; return }
    if op == OP_JMP_IF_FALSE { if !vm_getReg(a) { vm_pc = b }; return }
    if op == OP_CALL { vm_executeCall(a, b, c); return }
    if op == OP_RET { vm_executeRet(a); return }
    if op == OP_PRINT { io.print(convert.toString(vm_getReg(a))); return }
    if op == OP_PRINTLN { io.println(convert.toString(vm_getReg(a))); return }
    if op == OP_PUSH { arrays.push(vm_argStack, vm_getReg(a)); return }
    if op == OP_HALT { vm_halted = true; vm_result = vm_getReg(vm_lastResultReg); return }
    if op == OP_NOP { return }
    if op == OP_MAKE_ARRAY { vm_executeMakeArray(a, b); return }
    if op == OP_MAKE_MAP { vm_executeMakeMap(a, b); return }
    if op == OP_INDEX_GET { vm_executeIndexGet(a, b, c); return }
    if op == OP_INDEX_SET { vm_executeIndexSet(a, b, c); return }
    if op == OP_MEMBER_GET { vm_executeMemberGet(a, b, c); return }
    if op == OP_MEMBER_SET { vm_executeMemberSet(a, b, c); return }
    if op == OP_LOAD_BUILTIN { vm_setReg(a, { __builtin: true, idx: b }); return }
    if op == OP_CONCAT { vm_setReg(a, convert.toString(vm_getReg(b)) + convert.toString(vm_getReg(c))); return }
    if op == OP_THROW { vm_halted = true; io.println("Runtime error: " + convert.toString(vm_getReg(a))); return }
    if op == OP_TRY_START { return }
    if op == OP_TRY_END { return }
}

// ============ CALL ============
fn vm_executeCall(resultReg: int, fnIdxOrReg: int, argCount: int) -> void {
    let args: auto = []
    let i = 0
    while i < argCount {
        let val = arrays.get(vm_argStack, arrays.length(vm_argStack) - 1)
        arrays.pop(vm_argStack)
        let newArgs: auto = [val]
        let j = 0
        while j < arrays.length(args) {
            arrays.push(newArgs, arrays.get(args, j))
            j = j + 1
        }
        args = newArgs
        i = i + 1
    }

    // Indirect call: fnIdxOrReg >= 100000 means (fnIdxOrReg - 100000) is register number
    let actualFnIdx = fnIdxOrReg
    let possibleFn = null
    if fnIdxOrReg >= 100000 {
        let regNum = fnIdxOrReg - 100000
        possibleFn = vm_getReg(regNum)
    } else {
        possibleFn = vm_getReg(fnIdxOrReg)
    }

    if convert.typeOf(possibleFn) == "object" && possibleFn["__builtin"] == true {
        vm_setReg(resultReg, vm_callBuiltin(possibleFn, args))
        return
    }

    if actualFnIdx >= 0 && actualFnIdx < arrays.length(vm_functions) {
        vm_saveFrame()
        let func = arrays.get(vm_functions, fnIdxOrReg)
        vm_fnIdx = fnIdxOrReg
        vm_pc = 0
        vm_registers = vm_initRegisters()
        let localCount = func["localCount"]
        if localCount == null { localCount = 0 }
        vm_locals = []
        let li = 0
        while li < localCount {
            arrays.push(vm_locals, null)
            li = li + 1
        }
        let paramCount = func["paramCount"]
        if paramCount == null { paramCount = 0 }
        let pi = 0
        while pi < argCount && pi < paramCount {
            vm_setLocal(pi, arrays.get(args, pi))
            pi = pi + 1
        }
        vm_argStack = []
        vm_returnReg = resultReg
    }
}

// ============ RET ============
fn vm_executeRet(regIdx: int) -> void {
    let returnValue = vm_getReg(regIdx)
    let retReg = vm_returnReg
    if arrays.length(vm_callStack) == 0 {
        vm_halted = true
        vm_result = returnValue
        return
    }
    vm_restoreFrame()
    if retReg >= 0 {
        vm_setReg(retReg, returnValue)
    }
}

// ============ MAKE_ARRAY ============
fn vm_executeMakeArray(resultReg: int, count: int) -> void {
    let elements: auto = []
    let i = 0
    while i < count {
        let val = arrays.get(vm_argStack, arrays.length(vm_argStack) - 1)
        arrays.pop(vm_argStack)
        let newElems: auto = [val]
        let j = 0
        while j < arrays.length(elements) {
            arrays.push(newElems, arrays.get(elements, j))
            j = j + 1
        }
        elements = newElems
        i = i + 1
    }
    vm_setReg(resultReg, elements)
}

// ============ MAKE_MAP ============
// Use JSON serialization to create map dynamically, because TLL's
// index assignment (map["key"] = value) is currently broken.
fn vm_executeMakeMap(resultReg: int, count: int) -> void {
    // Pop all entries from stack (order: value_n, key_n, ..., value_1, key_1)
    let keys: auto = []
    let values: auto = []
    let i = 0
    while i < count {
        let v = arrays.get(vm_argStack, arrays.length(vm_argStack) - 1)
        arrays.pop(vm_argStack)
        let k = arrays.get(vm_argStack, arrays.length(vm_argStack) - 1)
        arrays.pop(vm_argStack)
        arrays.push(keys, convert.toString(k))
        arrays.push(values, v)
        i = i + 1
    }
    // Build JSON string: {"key1": val1, "key2": val2, ...}
    // entries are in reverse order (last pushed first), so iterate backwards
    let jsonStr = "{"
    let j = count - 1
    while j >= 0 {
        let k = arrays.get(keys, j)
        let v = arrays.get(values, j)
        if j < count - 1 {
            jsonStr = jsonStr + ","
        }
        jsonStr = jsonStr + "\"" + k + "\":" + json.stringify(v)
        j = j - 1
    }
    jsonStr = jsonStr + "}"
    let m = json.parse(jsonStr)
    vm_setReg(resultReg, m)
}

// ============ INDEX_GET ============
fn vm_executeIndexGet(resultReg: int, objReg: int, idxReg: int) -> void {
    let obj = vm_getReg(objReg)
    let idx = vm_getReg(idxReg)
    if convert.typeOf(obj) == "list" {
        vm_setReg(resultReg, arrays.get(obj, idx))
    } else {
        vm_setReg(resultReg, obj[convert.toString(idx)])
    }
}

// ============ INDEX_SET ============
fn vm_executeIndexSet(objReg: int, idxReg: int, valReg: int) -> void {
    let obj = vm_getReg(objReg)
    let idx = vm_getReg(idxReg)
    let val = vm_getReg(valReg)
    if convert.typeOf(obj) == "list" {
        obj[idx] = val
    } else {
        obj[convert.toString(idx)] = val
    }
    vm_setReg(objReg, obj)
}

// ============ MEMBER_GET ============
fn vm_executeMemberGet(resultReg: int, objReg: int, constIdx: int) -> void {
    let obj = vm_getReg(objReg)
    let propName = arrays.get(vm_constants, constIdx)
    if propName == "length" && convert.typeOf(obj) == "list" {
        vm_setReg(resultReg, arrays.length(obj))
    } else if obj != null {
        vm_setReg(resultReg, obj[propName])
    } else {
        vm_setReg(resultReg, null)
    }
}

// ============ MEMBER_SET ============
fn vm_executeMemberSet(objReg: int, constIdx: int, valReg: int) -> void {
    let obj = vm_getReg(objReg)
    let propName = arrays.get(vm_constants, constIdx)
    let val = vm_getReg(valReg)
    if obj != null {
        obj[propName] = val
        vm_setReg(objReg, obj)
    }
}

// ============ Call builtin (full implementation v1.2.1) ============
fn vm_callBuiltin(builtin: map, args: auto) -> any {
    let idx = builtin["idx"]

    // === io (0-2) ===
    if idx == 0 {
        if arrays.length(args) > 0 { io.println(convert.toString(arrays.get(args, 0))) } else { io.println("") }
        return null
    }
    if idx == 1 {
        if arrays.length(args) > 0 { io.print(convert.toString(arrays.get(args, 0))) }
        return null
    }
    if idx == 2 {
        if arrays.length(args) > 0 { return io.readLine(convert.toString(arrays.get(args, 0))) }
        return io.readLine("")
    }

    // === strings (24-48) ===
    if idx == 24 { return strings.length(convert.toString(arrays.get(args, 0))) }
    if idx == 25 { return strings.toUpper(convert.toString(arrays.get(args, 0))) }
    if idx == 26 { return strings.toLower(convert.toString(arrays.get(args, 0))) }
    if idx == 27 { return strings.trim(convert.toString(arrays.get(args, 0))) }
    if idx == 28 { return strings.trimStart(convert.toString(arrays.get(args, 0))) }
    if idx == 29 { return strings.trimEnd(convert.toString(arrays.get(args, 0))) }
    if idx == 30 { return strings.split(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1))) }
    if idx == 31 { return strings.join(arrays.get(args, 0), convert.toString(arrays.get(args, 1))) }
    if idx == 32 { return strings.contains(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1))) }
    if idx == 33 { return strings.startsWith(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1))) }
    if idx == 34 { return strings.endsWith(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1))) }
    if idx == 35 {
        if arrays.length(args) > 2 { return strings.substring(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)), convert.toInt(arrays.get(args, 2))) }
        return strings.substring(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)))
    }
    if idx == 36 { return strings.replace(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1)), convert.toString(arrays.get(args, 2))) }
    if idx == 37 { return strings.replaceAll(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1)), convert.toString(arrays.get(args, 2))) }
    if idx == 38 { return strings.repeat(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1))) }
    if idx == 39 {
        if arrays.length(args) > 2 { return strings.padStart(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)), convert.toString(arrays.get(args, 2))) }
        return strings.padStart(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)))
    }
    if idx == 40 {
        if arrays.length(args) > 2 { return strings.padEnd(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)), convert.toString(arrays.get(args, 2))) }
        return strings.padEnd(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)))
    }
    if idx == 41 { return strings.charAt(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1))) }
    if idx == 42 { return strings.charCodeAt(convert.toString(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1))) }
    if idx == 43 { return strings.indexOf(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1))) }
    if idx == 44 { return strings.lastIndexOf(convert.toString(arrays.get(args, 0)), convert.toString(arrays.get(args, 1))) }
    if idx == 45 { return strings.isEmpty(convert.toString(arrays.get(args, 0))) }
    if idx == 46 { return strings.reverse(convert.toString(arrays.get(args, 0))) }
    if idx == 47 { return strings.lines(convert.toString(arrays.get(args, 0))) }
    if idx == 48 { return strings.words(convert.toString(arrays.get(args, 0))) }

    // === arrays (49-71) ===
    if idx == 49 { return arrays.length(arrays.get(args, 0)) }
    if idx == 50 { return arrays.get(arrays.get(args, 0), convert.toInt(arrays.get(args, 1))) }
    if idx == 51 {
        let arr51 = arrays.get(args, 0)
        let i51 = 1
        while i51 < arrays.length(args) {
            arrays.push(arr51, arrays.get(args, i51))
            i51 = i51 + 1
        }
        return arr51
    }
    if idx == 52 { return arrays.pop(arrays.get(args, 0)) }
    if idx == 53 { return arrays.shift(arrays.get(args, 0)) }
    if idx == 54 {
        let arr54 = arrays.get(args, 0)
        let i54 = arrays.length(args) - 1
        while i54 >= 1 {
            arrays.unshift(arr54, arrays.get(args, i54))
            i54 = i54 - 1
        }
        return arr54
    }
    if idx == 55 { return arrays.concat(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 56 {
        if arrays.length(args) > 2 { return arrays.slice(arrays.get(args, 0), convert.toInt(arrays.get(args, 1)), convert.toInt(arrays.get(args, 2))) }
        return arrays.slice(arrays.get(args, 0), convert.toInt(arrays.get(args, 1)))
    }
    if idx == 57 { return arrays.includes(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 58 { return arrays.indexOf(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 59 { return arrays.join(arrays.get(args, 0), convert.toString(arrays.get(args, 1))) }
    if idx == 60 { return arrays.reverse(arrays.get(args, 0)) }
    if idx == 61 { return arrays.sort(arrays.get(args, 0)) }
    if idx == 62 { return arrays.filter(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 63 { return arrays.map(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 64 {
        if arrays.length(args) > 2 { return arrays.reduce(arrays.get(args, 0), arrays.get(args, 1), arrays.get(args, 2)) }
        return arrays.reduce(arrays.get(args, 0), arrays.get(args, 1))
    }
    if idx == 65 { arrays.forEach(arrays.get(args, 0), arrays.get(args, 1)); return null }
    if idx == 66 { return arrays.find(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 67 { return arrays.some(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 68 { return arrays.every(arrays.get(args, 0), arrays.get(args, 1)) }
    if idx == 69 {
        if arrays.length(args) > 1 { return arrays.flat(arrays.get(args, 0), convert.toInt(arrays.get(args, 1))) }
        return arrays.flat(arrays.get(args, 0))
    }
    if idx == 70 {
        if arrays.length(args) > 3 { return arrays.fill(arrays.get(args, 0), arrays.get(args, 1), convert.toInt(arrays.get(args, 2)), convert.toInt(arrays.get(args, 3))) }
        if arrays.length(args) > 2 { return arrays.fill(arrays.get(args, 0), arrays.get(args, 1), convert.toInt(arrays.get(args, 2))) }
        return arrays.fill(arrays.get(args, 0), arrays.get(args, 1))
    }
    if idx == 71 {
        if arrays.length(args) > 2 { return arrays.range(convert.toInt(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)), convert.toInt(arrays.get(args, 2))) }
        return arrays.range(convert.toInt(arrays.get(args, 0)), convert.toInt(arrays.get(args, 1)))
    }

    // === convert (72-78) ===
    if idx == 72 { return convert.toInt(arrays.get(args, 0)) }
    if idx == 73 { return convert.toFloat(arrays.get(args, 0)) }
    if idx == 74 { return convert.toString(arrays.get(args, 0)) }
    if idx == 75 { return convert.toBool(arrays.get(args, 0)) }
    if idx == 76 { return convert.toChar(convert.toInt(arrays.get(args, 0))) }
    if idx == 77 { return convert.charCode(convert.toString(arrays.get(args, 0))) }
    if idx == 78 { return convert.typeOf(arrays.get(args, 0)) }

    // === Not yet implemented (json 3-4, math 5-23, fs 79-90, http 91-97, agent 98-111, workflow 112-119) ===
    if arrays.length(args) > 0 { return arrays.get(args, 0) }
    return null
}
