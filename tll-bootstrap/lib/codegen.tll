// TLL Codegen - Self-hosting Bootstrap (v1.0 Phase 4)
// AST to bytecode compiler, rewritten from TypeScript
// Uses parallel lists for maps (TLL map field access is unreliable)

// ============ OpCode constants ============
let OP_LOAD_CONST = 0
let OP_LOAD_VAR = 1
let OP_STORE_VAR = 2
let OP_ADD = 3
let OP_SUB = 4
let OP_MUL = 5
let OP_DIV = 6
let OP_MOD = 7
let OP_POW = 8
let OP_EQ = 9
let OP_NEQ = 10
let OP_LT = 11
let OP_GT = 12
let OP_LE = 13
let OP_GE = 14
let OP_AND = 15
let OP_OR = 16
let OP_NOT = 17
let OP_NEG = 18
let OP_JMP = 19
let OP_JMP_IF_FALSE = 20
let OP_CALL = 21
let OP_RET = 22
let OP_PRINT = 23
let OP_PRINTLN = 24
let OP_MAKE_ARRAY = 25
let OP_MAKE_MAP = 26
let OP_INDEX_GET = 28
let OP_INDEX_SET = 29
let OP_MEMBER_GET = 30
let OP_MEMBER_SET = 31
let OP_HALT = 32
let OP_NOP = 33
let OP_PUSH = 34
let OP_CONCAT = 35
let OP_LOAD_BUILTIN = 36
let OP_THROW = 37
let OP_TRY_START = 38
let OP_TRY_END = 39
let OP_LOAD_GLOBAL = 40
let OP_STORE_GLOBAL = 41

// ============ Codegen state ============
let cg_instructions: list = []
let cg_constants: list = []
let cg_regCount = 0
let cg_labelCounter = 0
let cg_functions: list = []
let cg_currentFn: map = null
let cg_loopContexts: list = []
let cg_currentBreakLabel = -1
let cg_currentContinueLabel = -1
let cg_breakPatchList: list = []
let cg_mainFnIndex = 0
let cg_allFnInstructions: list = []
let cg_allFnLocalCounts: list = []
let cg_currentLocalCount = 0

// Parallel lists for maps (TLL map field access is unreliable)
let cg_fnMapKeys: list = []
let cg_fnMapVals: list = []
let cg_varMapKeys: list = []
let cg_varMapVals: list = []
let cg_globalMapKeys: list = []
let cg_globalMapVals: list = []

// ============ Map helpers (direct global access, no param passing) ============
fn cg_fnMapGet(key: string) -> any {
    let i = 0
    while i < arrays.length(cg_fnMapKeys) {
        if arrays.get(cg_fnMapKeys, i) == key {
            return arrays.get(cg_fnMapVals, i)
        }
        i = i + 1
    }
    return null
}

fn cg_fnMapSet(key: string, value: any) -> void {
    arrays.push(cg_fnMapKeys, key)
    arrays.push(cg_fnMapVals, value)
}

fn cg_varMapGet(key: string) -> any {
    let i = 0
    while i < arrays.length(cg_varMapKeys) {
        if arrays.get(cg_varMapKeys, i) == key {
            return arrays.get(cg_varMapVals, i)
        }
        i = i + 1
    }
    return null
}

fn cg_varMapSet(key: string, value: any) -> void {
    arrays.push(cg_varMapKeys, key)
    arrays.push(cg_varMapVals, value)
}

fn cg_globalMapGet(key: string) -> any {
    let i = 0
    while i < arrays.length(cg_globalMapKeys) {
        if arrays.get(cg_globalMapKeys, i) == key {
            return arrays.get(cg_globalMapVals, i)
        }
        i = i + 1
    }
    return null
}

fn cg_globalMapSet(key: string, value: any) -> void {
    arrays.push(cg_globalMapKeys, key)
    arrays.push(cg_globalMapVals, value)
}

// ============ Simple helpers ============
fn cg_emit(opCode: int, opOperands: list) -> void {
    let inst = { op: opCode, operands: opOperands }
    arrays.push(cg_instructions, inst)
}

fn cg_allocReg() -> int {
    let r = cg_regCount
    cg_regCount = cg_regCount + 1
    return r
}

fn cg_addConstant(value: any) -> int {
    arrays.push(cg_constants, value)
    return arrays.length(cg_constants) - 1
}

fn cg_newLabel() -> int {
    let l = cg_labelCounter
    cg_labelCounter = cg_labelCounter + 1
    return l
}

fn cg_patchJump(instrIndex: int) -> void {
    let inst = arrays.get(cg_instructions, instrIndex)
    let operands = inst.operands
    let newOperands: list = []
    let i = 0
    while i < arrays.length(operands) - 1 {
        arrays.push(newOperands, arrays.get(operands, i))
        i = i + 1
    }
    arrays.push(newOperands, arrays.length(cg_instructions))
    inst.operands = newOperands
}

fn cg_getOrCreateVar(name: string) -> int {
    let idx = cg_varMapGet(name)
    if idx == null {
        idx = cg_currentLocalCount
        cg_currentLocalCount = idx + 1
        cg_varMapSet(name, idx)
    }
    return idx
}

fn cg_resolveVar(name: string) -> map {
    let localIdx = cg_varMapGet(name)
    if localIdx != null {
        return { index: localIdx, isGlobal: false }
    }
    let globalIdx = cg_globalMapGet(name)
    if globalIdx != null {
        return { index: globalIdx, isGlobal: true }
    }
    let idx = cg_currentLocalCount
    cg_currentLocalCount = idx + 1
    cg_varMapSet(name, idx)
    return { index: idx, isGlobal: false }
}

// ============ Main entry ============
export fn compile(program: map) -> map {
    cg_instructions = []
    cg_constants = []
    cg_regCount = 0
    cg_labelCounter = 0
    cg_functions = []
    cg_loopContexts = []
    cg_currentBreakLabel = -1
    cg_currentContinueLabel = -1
    cg_breakPatchList = []
    cg_allFnInstructions = []
    cg_allFnLocalCounts = []
    cg_currentLocalCount = 0
    cg_fnMapKeys = []
    cg_fnMapVals = []
    cg_varMapKeys = []
    cg_varMapVals = []
    cg_globalMapKeys = []
    cg_globalMapVals = []

    let stmts = program.statements

    // First pass: collect global variables and function declarations
    let globalCounter = 0
    let p1i = 0
    while p1i < arrays.length(stmts) {
        let stmt = arrays.get(stmts, p1i)
        let kind = stmt.kind
        if kind == "Let" || kind == "Const" {
            cg_globalMapSet(stmt.name, globalCounter)
            globalCounter = globalCounter + 1
        }
        if kind == "Fn" {
            let fnIdx = arrays.length(cg_functions)
            cg_fnMapSet(stmt.name, fnIdx)
            let fnObj = { name: stmt.name, paramCount: arrays.length(stmt.params), instructions: [], localCount: 0 }
            arrays.push(cg_functions, fnObj)
        }
        if kind == "Export" {
            let decl = stmt.declaration
            if decl.kind == "Fn" {
                let fnIdx = arrays.length(cg_functions)
                cg_fnMapSet(decl.name, fnIdx)
                let fnObj = { name: decl.name, paramCount: arrays.length(decl.params), instructions: [], localCount: 0 }
                arrays.push(cg_functions, fnObj)
            }
        }
        p1i = p1i + 1
    }

    // Create main function
    cg_mainFnIndex = arrays.length(cg_functions)
    let mainFn = { name: "__main__", paramCount: 0, instructions: [], localCount: 0 }
    arrays.push(cg_functions, mainFn)

    // Second pass: compile function bodies
    let p2i = 0
    while p2i < arrays.length(stmts) {
        let stmt = arrays.get(stmts, p2i)
        if stmt.kind == "Fn" {
            cg_compileFunction(stmt)
            arrays.push(cg_allFnInstructions, cg_instructions)
            arrays.push(cg_allFnLocalCounts, cg_currentLocalCount)
        }
        if stmt.kind == "Export" {
            let decl = stmt.declaration
            if decl.kind == "Fn" {
                cg_compileFunction(decl)
                arrays.push(cg_allFnInstructions, cg_instructions)
                arrays.push(cg_allFnLocalCounts, cg_currentLocalCount)
            }
        }
        p2i = p2i + 1
    }

    // Compile main
    cg_currentFn = arrays.get(cg_functions, cg_mainFnIndex)
    cg_regCount = 0
    cg_varMapKeys = []
    cg_varMapVals = []
    cg_labelCounter = 0
    cg_instructions = []
    cg_currentLocalCount = 0

    let mi = 0
    while mi < arrays.length(stmts) {
        let stmt = arrays.get(stmts, mi)
        let kind = stmt.kind
        if kind != "Fn" && kind != "Import" && kind != "FromImport" && kind != "Export" {
            cg_compileStatement(stmt)
        }
        mi = mi + 1
    }

    cg_emit(OP_HALT, [])
    arrays.push(cg_allFnInstructions, cg_instructions)
    arrays.push(cg_allFnLocalCounts, cg_currentLocalCount)

    // Rebuild functions list
    let finalFunctions: list = []
    let ffi = 0
    while ffi < arrays.length(cg_functions) {
        let func = arrays.get(cg_functions, ffi)
        let instrs = arrays.get(cg_allFnInstructions, ffi)
        let localCount = arrays.get(cg_allFnLocalCounts, ffi)
        let newFn = { name: func.name, paramCount: func.paramCount, instructions: instrs, localCount: localCount }
        arrays.push(finalFunctions, newFn)
        ffi = ffi + 1
    }

    return {
        constants: cg_constants,
        functions: finalFunctions,
        mainFunctionIndex: cg_mainFnIndex,
        globalCount: globalCounter
    }
}

// ============ Function compilation ============
fn cg_compileFunction(fnDecl: map) -> void {
    // Search cg_functions list directly (avoid map issues)
    let fnName = fnDecl.name
    let fnIdx = -1
    let fi = 0
    while fi < arrays.length(cg_functions) {
        let f = arrays.get(cg_functions, fi)
        if f.name == fnName {
            fnIdx = fi
            fi = arrays.length(cg_functions)
        }
        fi = fi + 1
    }
    cg_currentFn = arrays.get(cg_functions, fnIdx)
    cg_regCount = 0
    cg_varMapKeys = []
    cg_varMapVals = []
    cg_labelCounter = 0
    cg_instructions = []

    let params = fnDecl.params
    let i = 0
    while i < arrays.length(params) {
        cg_varMapSet(arrays.get(params, i)["name"], i)
        i = i + 1
    }
    cg_currentLocalCount = arrays.length(params)

    cg_compileBlock(fnDecl.body)

    let voidReg = cg_allocReg()
    cg_emit(OP_LOAD_CONST, [voidReg, cg_addConstant(null)])
    cg_emit(OP_RET, [voidReg])
}

fn cg_compileBlock(block: map) -> void {
    let stmts = block.statements
    let i = 0
    while i < arrays.length(stmts) {
        cg_compileStatement(arrays.get(stmts, i))
        i = i + 1
    }
}

// ============ Statement compilation ============
fn cg_compileStatement(stmt: map) -> void {
    if stmt == null { return }
    let kind = stmt.kind

    if kind == "Let" || kind == "Const" {
        let valueReg = cg_compileExpression(stmt.value)
        let resolved = cg_resolveVar(stmt.name)
        if resolved.isGlobal {
            cg_emit(OP_STORE_GLOBAL, [resolved.index, valueReg])
        } else {
            cg_emit(OP_STORE_VAR, [resolved.index, valueReg])
        }
        return
    }

    if kind == "Return" {
        if stmt.value != null {
            let reg = cg_compileExpression(stmt.value)
            cg_emit(OP_RET, [reg])
        } else {
            let reg = cg_allocReg()
            cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(null)])
            cg_emit(OP_RET, [reg])
        }
        return
    }

    if kind == "If" { cg_compileIf(stmt); return }
    if kind == "While" { cg_compileWhile(stmt); return }
    if kind == "Break" {
        let breakIdx = arrays.length(cg_instructions)
        cg_emit(OP_JMP, [-1])
        arrays.push(cg_breakPatchList, breakIdx)
        return
    }
    if kind == "Continue" {
        cg_emit(OP_JMP, [cg_currentContinueLabel])
        return
    }
    if kind == "Throw" { let r = cg_compileExpression(stmt.value); cg_emit(OP_THROW, [r]); return }
    if kind == "Block" { cg_compileBlock(stmt); return }
    if kind == "ExpressionStatement" { cg_compileExpression(stmt.expression); return }
    if kind == "Export" { cg_compileStatement(stmt.declaration); return }
}

fn cg_compileIf(stmt: map) -> void {
    let condReg = cg_compileExpression(stmt.condition)
    let jmpFalseIdx = arrays.length(cg_instructions)
    cg_emit(OP_JMP_IF_FALSE, [condReg, -1])
    cg_compileBlock(stmt.consequent)
    if stmt.alternate != null {
        let jmpEndIdx = arrays.length(cg_instructions)
        cg_emit(OP_JMP, [-1])
        cg_patchJump(jmpFalseIdx)
        let alt = stmt.alternate
        if alt.kind == "If" { cg_compileIf(alt) } else { cg_compileBlock(alt) }
        cg_patchJump(jmpEndIdx)
    } else {
        cg_patchJump(jmpFalseIdx)
    }
}

fn cg_compileWhile(stmt: map) -> void {
    let startIdx = arrays.length(cg_instructions)
    let condReg = cg_compileExpression(stmt.condition)
    let jmpEndIdx = arrays.length(cg_instructions)
    cg_emit(OP_JMP_IF_FALSE, [condReg, -1])

    // Save old loop context
    let oldBreakLabel = cg_currentBreakLabel
    let oldContinueLabel = cg_currentContinueLabel
    let oldBreakPatchList = cg_breakPatchList

    // Set new loop context
    cg_currentBreakLabel = -1
    cg_currentContinueLabel = startIdx
    cg_breakPatchList = []

    cg_compileBlock(stmt.body)

    // Patch all break statements to jump to after the loop
    let breakTarget = arrays.length(cg_instructions) + 1
    let bi = 0
    while bi < arrays.length(cg_breakPatchList) {
        let breakIdx = arrays.get(cg_breakPatchList, bi)
        let inst = arrays.get(cg_instructions, breakIdx)
        inst.operands = [breakTarget]
        bi = bi + 1
    }

    // Restore old loop context
    cg_currentBreakLabel = oldBreakLabel
    cg_currentContinueLabel = oldContinueLabel
    cg_breakPatchList = oldBreakPatchList

    cg_emit(OP_JMP, [startIdx])
    cg_patchJump(jmpEndIdx)
}

// ============ Expression compilation ============
fn cg_compileExpression(expr: map) -> int {
    if expr == null {
        let reg = cg_allocReg()
        cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(null)])
        return reg
    }
    let kind = expr.kind

    if kind == "Int" {
        let reg = cg_allocReg()
        cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(cg_parseInt(expr.value))])
        return reg
    }
    if kind == "Float" {
        let reg = cg_allocReg()
        cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(convert.toFloat(expr.value))])
        return reg
    }
    if kind == "String" {
        let reg = cg_allocReg()
        cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(expr.value)])
        return reg
    }
    if kind == "Bool" {
        let reg = cg_allocReg()
        cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(expr.value)])
        return reg
    }
    if kind == "Null" {
        let reg = cg_allocReg()
        cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(null)])
        return reg
    }
    if kind == "Ident" { return cg_compileIdent(expr) }
    if kind == "Binary" { return cg_compileBinary(expr) }
    if kind == "Unary" { return cg_compileUnary(expr) }
    if kind == "Call" { return cg_compileCall(expr) }
    if kind == "Member" {
        let objReg = cg_compileExpression(expr.object)
        let reg = cg_allocReg()
        cg_emit(OP_MEMBER_GET, [reg, objReg, cg_addConstant(expr.property)])
        return reg
    }
    if kind == "Index" {
        let objReg = cg_compileExpression(expr.object)
        let idxReg = cg_compileExpression(expr.index)
        let reg = cg_allocReg()
        cg_emit(OP_INDEX_GET, [reg, objReg, idxReg])
        return reg
    }
    if kind == "Array" { return cg_compileArray(expr) }
    if kind == "Map" { return cg_compileMap(expr) }

    let reg = cg_allocReg()
    cg_emit(OP_LOAD_CONST, [reg, cg_addConstant(null)])
    return reg
}

fn cg_compileIdent(expr: map) -> int {
    let reg = cg_allocReg()
    let resolved = cg_resolveVar(expr.name)
    if resolved.isGlobal {
        cg_emit(OP_LOAD_GLOBAL, [reg, resolved.index])
    } else {
        cg_emit(OP_LOAD_VAR, [reg, resolved.index])
    }
    return reg
}

fn cg_compileBinary(expr: map) -> int {
    let leftReg = cg_compileExpression(expr.left)
    let rightReg = cg_compileExpression(expr.right)
    let resultReg = cg_allocReg()
    let op = expr.operator

    if op == "+" { cg_emit(OP_ADD, [resultReg, leftReg, rightReg]) }
    else if op == "-" { cg_emit(OP_SUB, [resultReg, leftReg, rightReg]) }
    else if op == "*" { cg_emit(OP_MUL, [resultReg, leftReg, rightReg]) }
    else if op == "/" { cg_emit(OP_DIV, [resultReg, leftReg, rightReg]) }
    else if op == "%" { cg_emit(OP_MOD, [resultReg, leftReg, rightReg]) }
    else if op == "**" { cg_emit(OP_POW, [resultReg, leftReg, rightReg]) }
    else if op == "==" { cg_emit(OP_EQ, [resultReg, leftReg, rightReg]) }
    else if op == "!=" { cg_emit(OP_NEQ, [resultReg, leftReg, rightReg]) }
    else if op == "<" { cg_emit(OP_LT, [resultReg, leftReg, rightReg]) }
    else if op == ">" { cg_emit(OP_GT, [resultReg, leftReg, rightReg]) }
    else if op == "<=" { cg_emit(OP_LE, [resultReg, leftReg, rightReg]) }
    else if op == ">=" { cg_emit(OP_GE, [resultReg, leftReg, rightReg]) }
    else if op == "&&" { cg_emit(OP_AND, [resultReg, leftReg, rightReg]) }
    else if op == "||" { cg_emit(OP_OR, [resultReg, leftReg, rightReg]) }
    else if op == "=" {
        let leftKind = expr.left["kind"]
        if leftKind == "Ident" {
            let resolved = cg_resolveVar(expr.left["name"])
            if resolved.isGlobal { cg_emit(OP_STORE_GLOBAL, [resolved.index, rightReg]) }
            else { cg_emit(OP_STORE_VAR, [resolved.index, rightReg]) }
            return rightReg
        }
        if leftKind == "Member" {
            let objReg = cg_compileExpression(expr.left["object"])
            let propConst = cg_addConstant(expr.left["property"])
            cg_emit(OP_MEMBER_SET, [objReg, propConst, rightReg])
            return rightReg
        }
        if leftKind == "Index" {
            let objReg = cg_compileExpression(expr.left["object"])
            let idxReg = cg_compileExpression(expr.left["index"])
            cg_emit(OP_INDEX_SET, [objReg, idxReg, rightReg])
            return rightReg
        }
        cg_emit(OP_LOAD_CONST, [resultReg, cg_addConstant(null)])
    } else {
        cg_emit(OP_LOAD_CONST, [resultReg, cg_addConstant(null)])
    }
    return resultReg
}

fn cg_compileUnary(expr: map) -> int {
    let operandReg = cg_compileExpression(expr.operand)
    let resultReg = cg_allocReg()
    let op = expr.operator
    if op == "-" { cg_emit(OP_NEG, [resultReg, operandReg]) }
    else if op == "!" { cg_emit(OP_NOT, [resultReg, operandReg]) }
    else { cg_emit(OP_LOAD_CONST, [resultReg, cg_addConstant(null)]) }
    return resultReg
}

fn cg_compileCall(expr: map) -> int {
    let resultReg = cg_allocReg()
    let args = expr.args
    let callee = expr.callee

    // Special handling: io.println -> PRINTLN opcode
    if callee["kind"] == "Member" && callee.object["kind"] == "Ident" && callee.object["name"] == "io" && callee["property"] == "println" {
        if arrays.length(args) > 0 {
            let argReg = cg_compileExpression(arrays.get(args, 0))
            cg_emit(OP_PRINTLN, [argReg])
        } else {
            let reg = cg_allocReg()
            cg_emit(OP_LOAD_CONST, [reg, cg_addConstant("")])
            cg_emit(OP_PRINTLN, [reg])
        }
        cg_emit(OP_LOAD_CONST, [resultReg, cg_addConstant(null)])
        return resultReg
    }

    // Special handling: io.print -> PRINT opcode
    if callee["kind"] == "Member" && callee.object["kind"] == "Ident" && callee.object["name"] == "io" && callee["property"] == "print" {
        if arrays.length(args) > 0 {
            let argReg = cg_compileExpression(arrays.get(args, 0))
            cg_emit(OP_PRINT, [argReg])
        }
        cg_emit(OP_LOAD_CONST, [resultReg, cg_addConstant(null)])
        return resultReg
    }

    // Standard library function call (module.function) -> LOAD_BUILTIN + CALL
    if callee["kind"] == "Member" && callee.object["kind"] == "Ident" {
        let modName = callee.object["name"]
        let fnName = callee["property"]
        let builtinIdx = cg_getBuiltinIndex(modName, fnName)
        if builtinIdx >= 0 {
            let argRegs: list = []
            let ai = 0
            while ai < arrays.length(args) {
                let argReg = cg_compileExpression(arrays.get(args, ai))
                arrays.push(argRegs, argReg)
                cg_emit(OP_PUSH, [argReg])
                ai = ai + 1
            }
            let fnReg = cg_allocReg()
            cg_emit(OP_LOAD_BUILTIN, [fnReg, builtinIdx])
            cg_emit(OP_CALL, [resultReg, fnReg + 100000, arrays.length(args)])
            return resultReg
        }
    }

    // Push args for user function / indirect calls
    let i = 0
    while i < arrays.length(args) {
        let argReg = cg_compileExpression(arrays.get(args, i))
        cg_emit(OP_PUSH, [argReg])
        i = i + 1
    }

    // Check for direct function call - use function name map for O(1) lookup
    if callee["kind"] == "Ident" {
        let calleeName = callee["name"]
        let foundIdx = cg_fnMapGet(calleeName)
        if foundIdx != null {
            cg_emit(OP_CALL, [resultReg, foundIdx, arrays.length(args)])
            return resultReg
        }
    }

    // Indirect call
    let calleeReg = cg_compileExpression(callee)
    cg_emit(OP_CALL, [resultReg, calleeReg + 100000, arrays.length(args)])
    return resultReg
}

// Builtin function index lookup (auto-generated to match TypeScript stdlib registration order)
fn cg_getBuiltinIndex(modName: string, fnName: string) -> int {
    if modName == "io" {
        if fnName == "println" { return 0 }
        if fnName == "print" { return 1 }
        if fnName == "readLine" { return 2 }
    }
    if modName == "json" {
        if fnName == "parse" { return 3 }
        if fnName == "stringify" { return 4 }
    }
    if modName == "math" {
        if fnName == "sqrt" { return 5 }
        if fnName == "abs" { return 6 }
        if fnName == "floor" { return 7 }
        if fnName == "ceil" { return 8 }
        if fnName == "round" { return 9 }
        if fnName == "min" { return 10 }
        if fnName == "max" { return 11 }
        if fnName == "pow" { return 12 }
        if fnName == "sin" { return 13 }
        if fnName == "cos" { return 14 }
        if fnName == "tan" { return 15 }
        if fnName == "log" { return 16 }
        if fnName == "log2" { return 17 }
        if fnName == "log10" { return 18 }
        if fnName == "exp" { return 19 }
        if fnName == "pi" { return 20 }
        if fnName == "e" { return 21 }
        if fnName == "random" { return 22 }
        if fnName == "randomInt" { return 23 }
    }
    if modName == "strings" {
        if fnName == "length" { return 24 }
        if fnName == "toUpper" { return 25 }
        if fnName == "toLower" { return 26 }
        if fnName == "trim" { return 27 }
        if fnName == "trimStart" { return 28 }
        if fnName == "trimEnd" { return 29 }
        if fnName == "split" { return 30 }
        if fnName == "join" { return 31 }
        if fnName == "contains" { return 32 }
        if fnName == "startsWith" { return 33 }
        if fnName == "endsWith" { return 34 }
        if fnName == "substring" { return 35 }
        if fnName == "replace" { return 36 }
        if fnName == "replaceAll" { return 37 }
        if fnName == "repeat" { return 38 }
        if fnName == "padStart" { return 39 }
        if fnName == "padEnd" { return 40 }
        if fnName == "charAt" { return 41 }
        if fnName == "charCodeAt" { return 42 }
        if fnName == "indexOf" { return 43 }
        if fnName == "lastIndexOf" { return 44 }
        if fnName == "isEmpty" { return 45 }
        if fnName == "reverse" { return 46 }
        if fnName == "lines" { return 47 }
        if fnName == "words" { return 48 }
    }
    if modName == "arrays" {
        if fnName == "length" { return 49 }
        if fnName == "get" { return 50 }
        if fnName == "push" { return 51 }
        if fnName == "pop" { return 52 }
        if fnName == "shift" { return 53 }
        if fnName == "unshift" { return 54 }
        if fnName == "concat" { return 55 }
        if fnName == "slice" { return 56 }
        if fnName == "includes" { return 57 }
        if fnName == "indexOf" { return 58 }
        if fnName == "join" { return 59 }
        if fnName == "reverse" { return 60 }
        if fnName == "sort" { return 61 }
        if fnName == "filter" { return 62 }
        if fnName == "map" { return 63 }
        if fnName == "reduce" { return 64 }
        if fnName == "forEach" { return 65 }
        if fnName == "find" { return 66 }
        if fnName == "some" { return 67 }
        if fnName == "every" { return 68 }
        if fnName == "flat" { return 69 }
        if fnName == "fill" { return 70 }
        if fnName == "range" { return 71 }
    }
    if modName == "convert" {
        if fnName == "toInt" { return 72 }
        if fnName == "toFloat" { return 73 }
        if fnName == "toString" { return 74 }
        if fnName == "toBool" { return 75 }
        if fnName == "toChar" { return 76 }
        if fnName == "charCode" { return 77 }
        if fnName == "typeOf" { return 78 }
    }
    if modName == "fs" {
        if fnName == "readFile" { return 79 }
        if fnName == "writeFile" { return 80 }
        if fnName == "appendFile" { return 81 }
        if fnName == "exists" { return 82 }
        if fnName == "mkdir" { return 83 }
        if fnName == "remove" { return 84 }
        if fnName == "listDir" { return 85 }
        if fnName == "isFile" { return 86 }
        if fnName == "isDir" { return 87 }
        if fnName == "fileSize" { return 88 }
        if fnName == "copyFile" { return 89 }
        if fnName == "rename" { return 90 }
    }
    if modName == "http" {
        if fnName == "get" { return 91 }
        if fnName == "getText" { return 92 }
        if fnName == "post" { return 93 }
        if fnName == "postJson" { return 94 }
        if fnName == "request" { return 95 }
        if fnName == "getStatus" { return 96 }
        if fnName == "download" { return 97 }
    }
    if modName == "agent" {
        if fnName == "run" { return 98 }
        if fnName == "chat" { return 99 }
        if fnName == "setApiKey" { return 100 }
        if fnName == "setBaseUrl" { return 101 }
        if fnName == "setModel" { return 102 }
        if fnName == "getModel" { return 103 }
        if fnName == "runWithTools" { return 104 }
        if fnName == "saveMemory" { return 105 }
        if fnName == "loadMemory" { return 106 }
        if fnName == "hasMemory" { return 107 }
        if fnName == "clearMemory" { return 108 }
        if fnName == "clearAllMemory" { return 109 }
        if fnName == "listMemory" { return 110 }
        if fnName == "getMemoryCount" { return 111 }
    }
    if modName == "workflow" {
        if fnName == "define" { return 112 }
        if fnName == "start" { return 113 }
        if fnName == "getState" { return 114 }
        if fnName == "transition" { return 115 }
        if fnName == "canTransition" { return 116 }
        if fnName == "list" { return 117 }
        if fnName == "getHistory" { return 118 }
        if fnName == "getStates" { return 119 }
    }
    return -1
}

fn cg_compileArray(expr: map) -> int {
    let reg = cg_allocReg()
    let elements = expr.elements
    let i = 0
    while i < arrays.length(elements) {
        let elemReg = cg_compileExpression(arrays.get(elements, i))
        cg_emit(OP_PUSH, [elemReg])
        i = i + 1
    }
    cg_emit(OP_MAKE_ARRAY, [reg, arrays.length(elements)])
    return reg
}

fn cg_compileMap(expr: map) -> int {
    let reg = cg_allocReg()
    let entries = expr.entries
    let i = 0
    while i < arrays.length(entries) {
        let entry = arrays.get(entries, i)
        // key is stored as a string by parser, load it as constant
        let kReg = cg_allocReg()
        cg_emit(OP_LOAD_CONST, [kReg, cg_addConstant(entry.key)])
        let vReg = cg_compileExpression(entry.value)
        cg_emit(OP_PUSH, [kReg])
        cg_emit(OP_PUSH, [vReg])
        i = i + 1
    }
    cg_emit(OP_MAKE_MAP, [reg, arrays.length(entries)])
    return reg
}

// ============ Utility ============
fn cg_parseInt(value: string) -> int {
    if strings.length(value) >= 2 {
        let prefix = strings.charAt(value, 0) + strings.charAt(value, 1)
        if prefix == "0x" || prefix == "0X" { return convert.toInt(value, 16) }
        if prefix == "0o" || prefix == "0O" { return convert.toInt(value, 8) }
        if prefix == "0b" || prefix == "0B" { return convert.toInt(value, 2) }
    }
    return convert.toInt(value, 10)
}
