// Nested call local variable isolation test
// Verifies that caller's local variables are not overwritten by callee

fn outer() {
    let i = 0
    let result = inner()
    i = i + 1
    return i + result
}

fn inner() {
    let i = 0
    while i < 10 {
        i = i + 1
    }
    return i
}

// Test 1: basic nested call isolation
io.println("=== Test 1: Basic nested call ===")
let r1 = outer()
io.println("outer() = " + convert.toString(r1))
if r1 == 11 {
    io.println("PASS ✅")
} else {
    io.println("FAIL ❌ (expected 11)")
}

// Test 2: multiple levels of nesting
fn level1() {
    let x = 100
    let y = level2()
    return x + y
}

fn level2() {
    let x = 200
    let y = level3()
    return x + y
}

fn level3() {
    let x = 300
    return x
}

io.println("")
io.println("=== Test 2: Triple nesting ===")
let r2 = level1()
io.println("level1() = " + convert.toString(r2))
if r2 == 600 {
    io.println("PASS ✅")
} else {
    io.println("FAIL ❌ (expected 600)")
}

// Test 3: loop variable isolation across calls
fn sumTo(n: int) -> int {
    let sum = 0
    let i = 1
    while i <= n {
        sum = sum + i
        i = i + 1
    }
    return sum
}

io.println("")
io.println("=== Test 3: Loop variable isolation ===")
let total = 0
let j = 0
while j < 5 {
    total = total + sumTo(j)
    j = j + 1
}
io.println("total = " + convert.toString(total))
if total == 20 {
    io.println("PASS ✅")
} else {
    io.println("FAIL ❌ (expected 20)")
}

io.println("")
io.println("=== All Isolation Tests Complete ===")
