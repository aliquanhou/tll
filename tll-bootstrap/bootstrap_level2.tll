// Bootstrap Level 2 Test
// Step 1: TLL compiler compiles compiler.tll -> Bytecode B
// Step 2: TLL VM executes Bytecode B -> outputs Bytecode C
// Step 3: Verify Bytecode C is valid

from "./lib/lexer" import tokenize
from "./lib/parser" import parse
from "./lib/typechecker" import check
from "./lib/codegen" import compile
from "./lib/vm" import run

io.println("=== Bootstrap Level 2 Test ===")
io.println("")

// Step 1: Compile compiler.tll with TLL compiler -> Bytecode B
io.println("[Step 1] Compiling compiler.tll with TLL compiler...")
let source = fs.readFile("compiler.tll")
let tokens = tokenize(source)
let ast = parse(tokens)
let errors = check(ast)
let bytecodeB = compile(ast)

io.println("  Functions in Bytecode B: " + convert.toString(arrays.length(bytecodeB.functions)))
let fi = 0
while fi < arrays.length(bytecodeB.functions) {
    let f = arrays.get(bytecodeB.functions, fi)
    io.println("    [" + convert.toString(fi) + "] " + f.name + " (instrs=" + convert.toString(arrays.length(f.instructions)) + ")")
    fi = fi + 1
}
io.println("  Constants in Bytecode B: " + convert.toString(arrays.length(bytecodeB.constants)))
io.println("")

// Step 2: Execute Bytecode B with TLL VM
// Bytecode B's main() reads compiler.tll and compiles it, outputting Bytecode C
io.println("[Step 2] Executing Bytecode B with TLL VM...")
io.println("  (Bytecode B will read compiler.tll and compile it)")
io.println("  --- Output from Bytecode B ---")
let result = run(bytecodeB)
io.println("  --- End of Bytecode B output ---")
io.println("  VM return value: " + convert.toString(result))
io.println("")

io.println("=== Bootstrap Level 2 Test Complete ===")
