from "./lib/lexer" import tokenize
from "./lib/parser" import parse
from "./lib/codegen" import compile
from "./lib/vm" import run

io.println("=== Debug: Simple Function ===")

// Test 1: no params, return constant
let code1 = "fn one() { return 1 } let r = one()"
io.println("Code: " + code1)
let t1 = tokenize(code1)
let a1 = parse(t1)
let p1 = compile(a1)
// Print function instructions
let funcs = p1["functions"]
io.println("Functions: " + convert.toString(arrays.length(funcs)))
let fi = 0
while fi < arrays.length(funcs) {
    let f = arrays.get(funcs, fi)
    io.println("  [" + convert.toString(fi) + "] " + f["name"] + " locals=" + convert.toString(f["localCount"]) + " instrs=" + convert.toString(arrays.length(f["instructions"])))
    let instrs = f["instructions"]
    let ii = 0
    while ii < arrays.length(instrs) {
        let inst = arrays.get(instrs, ii)
        io.println("    " + convert.toString(ii) + ": op=" + convert.toString(inst["op"]) + " operands=" + convert.toString(inst["operands"]))
        ii = ii + 1
    }
    fi = fi + 1
}
let r1 = run(p1)
io.println("Result: " + convert.toString(r1))
io.println("Expected: 1")
io.println("")

// Test 2: with params
let code2 = "fn add(a, b) { return a + b } let r = add(3, 4)"
io.println("Code: " + code2)
let t2 = tokenize(code2)
let a2 = parse(t2)
let p2 = compile(a2)
let funcs2 = p2["functions"]
let f0 = arrays.get(funcs2, 0)
io.println("add locals=" + convert.toString(f0["localCount"]) + " instrs=" + convert.toString(arrays.length(f0["instructions"])))
let r2 = run(p2)
io.println("Result: " + convert.toString(r2))
io.println("Expected: 7")
