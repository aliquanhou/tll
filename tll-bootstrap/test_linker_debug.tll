// Test linkAndCompile with error handling
from "./lib/linker" import linkAndCompile

io.println("=== LinkAndCompile Debug Test ===")
io.println("")

try {
    io.println("Calling linkAndCompile...")
    let bytecode = linkAndCompile("compiler.tll")
    io.println("linkAndCompile returned!")
    io.println("bytecode type: " + convert.typeOf(bytecode))
    if bytecode != null {
        io.println("Functions: " + convert.toString(arrays.length(bytecode.functions)))
        io.println("Constants: " + convert.toString(arrays.length(bytecode.constants)))
    } else {
        io.println("bytecode is null!")
    }
} catch err {
    io.println("ERROR caught: " + convert.toString(err))
}

io.println("")
io.println("=== Test Complete ===")
