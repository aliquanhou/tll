fn func0(a: int, b: int) -> int {
    let sum = a + b
    let diff = a - b
    let product = a * b
    let ratio = a / b
    let result = sum + diff + product + ratio
    return result
}

fn func1(a: int, b: int) -> int {
    let sum = a + b
    let diff = a - b
    let product = a * b
    let ratio = a / b
    let result = sum + diff + product + ratio
    let prev = func0(a, b)
    result = result + prev
    return result
}

