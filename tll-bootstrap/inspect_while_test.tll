// Compile test_while_break.tll with TLL compiler and inspect bytecode
from "./lib/linker" import linkAndCompile

io.println("=== Compiling test_while_break.tll with TLL compiler ===")

let bytecode = linkAndCompile("test_while_break.tll")

io.println("Functions: " + convert.toString(arrays.length(bytecode.functions)))
io.println("Constants: " + convert.toString(arrays.length(bytecode.constants)))
io.println("mainFunctionIndex: " + convert.toString(bytecode.mainFunctionIndex))

let mainFn = arrays.get(bytecode.functions, bytecode.mainFunctionIndex)
io.println("Main function: " + mainFn.name)
io.println("Main instructions count: " + convert.toString(arrays.length(mainFn.instructions)))

io.println("")
io.println("=== Main function instructions ===")
let i = 0
while i < arrays.length(mainFn.instructions) {
    let inst = arrays.get(mainFn.instructions, i)
    let opStr = convert.toString(inst.op)
    if inst.op == 0 { opStr = "LOAD_CONST" }
    if inst.op == 1 { opStr = "LOAD_VAR" }
    if inst.op == 2 { opStr = "STORE_VAR" }
    if inst.op == 19 { opStr = "JMP" }
    if inst.op == 20 { opStr = "JMP_IF_FALSE" }
    if inst.op == 24 { opStr = "PRINTLN" }
    if inst.op == 32 { opStr = "HALT" }
    io.println("  [" + convert.toString(i) + "] " + opStr + " operands=" + json.stringify(inst.operands))
    i = i + 1
}

io.println("")
io.println("=== Done ===")
