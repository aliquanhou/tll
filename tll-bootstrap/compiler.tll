// TLL Compiler - Self-hosting entry point
// Compiles TLL source code to TLL bytecode
// For self-hosting verification: reads its own source and compiles it

from "./lib/lexer" import tokenize
from "./lib/parser" import parse
from "./lib/typechecker" import check
from "./lib/codegen" import compile

// Main compile function: source string -> bytecode program (as JSON string)
export fn compileSource(source: string) -> string {
    // Phase 1: Lexer
    let tokens = tokenize(source)

    // Phase 2: Parser
    let ast = parse(tokens)

    // Phase 3: Type Checker (errors are collected, not fatal)
    let errors = check(ast)

    // Phase 4: Codegen
    let program = compile(ast)

    // Serialize bytecode program to JSON for comparison
    return json.stringify(program)
}

// Self-hosting: read our own source and compile it
fn main() -> void {
    // Read our own source file
    let source = fs.readFile("compiler.tll")
    let bytecodeJson = compileSource(source)
    io.println(bytecodeJson)
}

main()
