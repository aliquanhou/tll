// Inspect AST and bytecode for while+break test
from "./lib/linker" import linkAndCompile
from "./lib/lexer" import tokenize
from "./lib/parser" import parse

io.println("=== Step 1: Tokenize test_while_break.tll ===")
let source = fs.readFile("test_while_break.tll")
io.println("Source length: " + convert.toString(strings.length(source)))
let tokens = tokenize(source)
io.println("Tokens count: " + convert.toString(arrays.length(tokens)))

io.println("")
io.println("=== Step 2: Parse ===")
let ast = parse(tokens)
io.println("AST statements count: " + convert.toString(arrays.length(ast.statements)))
let si = 0
while si < arrays.length(ast.statements) {
    let s = arrays.get(ast.statements, si)
    io.println("  stmt[" + convert.toString(si) + "] kind=" + s.kind)
    si = si + 1
}

io.println("")
io.println("=== Step 3: Compile with TLL compiler ===")
let bytecode = linkAndCompile("test_while_break.tll")
io.println("Functions: " + convert.toString(arrays.length(bytecode.functions)))
io.println("Constants: " + convert.toString(arrays.length(bytecode.constants)))

let mainFn = arrays.get(bytecode.functions, bytecode.mainFunctionIndex)
io.println("Main instructions count: " + convert.toString(arrays.length(mainFn.instructions)))

io.println("")
io.println("=== Done ===")
