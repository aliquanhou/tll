// Generic module test compiler
from "./lib/linker" import linkAndCompile

let testFile = "test_modules/t31_main.tll"
io.println("=== Compiling " + testFile + " ===")
let bytecode = linkAndCompile(testFile)
io.println("Functions: " + convert.toString(arrays.length(bytecode.functions)))
io.println("Constants: " + convert.toString(arrays.length(bytecode.constants)))
let jsonStr = json.stringify(bytecode)
fs.writeFile("test_modules/t31_output.tllbc", jsonStr)
io.println("Saved to test_modules/t31_output.tllbc")
io.println("=== Done ===")
