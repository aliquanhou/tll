  "native_launcher_requirements": {
    "must_implement": [
      "io.println (0)",
      "io.print (1)",
      "io.readLine (2)",
      "fs.readFile (79) through fs.rename (90)",
      "http.get (91) through http.download (97)",
      "math.random (22)",
      "math.randomInt (23)"
    ],
    "must_not_implement": [
      "json.parse/stringify",
      "math (except random)",
      "strings.*",
      "arrays.*",
      "convert.*"
    ],
    "tll_stdlib_provided_by": "Precompiled into vm_run.tllbc or loaded as TLL modules"
  }
}
