{
  "version": "1.0.0",
  "description": "TLL OS Host ABI Specification - The boundary between TLL Language Core and Host Platform",
  "principle": "Host ABI provides only OS-level capabilities. All language-level computation (strings, arrays, math, json, convert) must be implemented in TLL stdlib.",
  "categories": {
    "host": "Functions that require OS/hardware access. Must be implemented by Native Launcher.",
    "stdlib": "Functions that can be implemented in pure TLL. Should not be in Host ABI.",
    "language_core": "Operations encoded as bytecode opcodes, not function calls."
  },
  "host_abi": {
