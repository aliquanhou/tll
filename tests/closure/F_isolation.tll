// F: Isolation - independent test
// Verify two counter instances have separate UpvalueBoxes
fn makeCounter() {
    let n = 0
    fn inc() {
        n = n + 1
        return n
    }
    return inc
}

fn main() {
    let c1 = makeCounter()
    let c2 = makeCounter()
    io.println(c1())
    io.println(c1())
    io.println(c2())
    io.println(c2())
    io.println(c1())
    io.println(c2())
}
main()
